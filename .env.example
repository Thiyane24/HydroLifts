Secret_Key=change-me
Hashing_Algorithm=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# IMPORTANT: use the Supabase **transaction pooler** (port 6543), NOT the
# direct host (port 5432). Render's network cannot reach the direct host
# (IPv6-only), and the pooler requires the `pgbouncer=true` flag which
# app/database.py auto-appends when it sees :6543 in the URL.
#
# Copy the URI from Supabase dashboard:
#   Project Settings → Database → Connection string → Transaction pooler
#
# It must look like:
#   postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
#
# The `postgres.<ref>` username is REQUIRED — without the project-ref
# segment, the pooler rejects the auth and you get "Network is unreachable"
# or "password authentication failed" at boot.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Backend público (consumido pelo frontend em produção)
VITE_API_URL=https://hydrolifts.onrender.com
