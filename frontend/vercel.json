{
  "$schema": "https://json.schemastore.org/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/((?!api/|assets/|favicon\\.ico|.*\\.(?:js|css|png|jpg|jpeg|svg|gif|webp|ico|woff2?|ttf|otf|map)).*)", "destination": "/index.html" }
  ]
}
